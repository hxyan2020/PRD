{
  "rewrites": [
    { "source": "/api/lark/events", "destination": "/api/lark/event" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/lark/weekly-report",
      "schedule": "0 8 * * 5"
    },
    {
      "path": "/api/lark/market-report",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/lark/daily-market-report",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/lark/alert-nudge",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/lark/oscillation-alert",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/lark/weekly-demo",
      "schedule": "*/15 * * * *"
    }
  ]
}
